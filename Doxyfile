# Doxyfile for the Collective Perception Service (CPS)
# Generate with: doxygen Doxyfile
# Output:        docs/doxygen/html/index.html

#---------------------------------------------------------------------------
# Project
#---------------------------------------------------------------------------

DOXYFILE_ENCODING      = UTF-8
PROJECT_NAME           = "Collective Perception Service"
PROJECT_NUMBER         = "2.0.0"
PROJECT_BRIEF          = "ETSI TS 103 324 CPS Implementation for V2X"
PROJECT_LOGO           =
OUTPUT_DIRECTORY       = docs/doxygen/

#---------------------------------------------------------------------------
# Build options
#---------------------------------------------------------------------------

EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
HIDE_UNDOC_NAMESPACES  = YES
HIDE_UNDOC_RELATIONS   = YES
BRIEF_MEMBER_DESC      = YES
REPEAT_BRIEF           = YES
ALWAYS_DETAILED_SEC    = NO
INLINE_INHERITED_MEMB  = NO
FULL_PATH_NAMES        = YES
JAVADOC_AUTOBRIEF      = NO
MARKDOWN_SUPPORT       = YES
MARKDOWN_STRICT        = YES
MARKDOWN_ID_STYLE      = GITHUB
TOC_INCLUDE_HEADINGS   = 6
USE_MDR_LINKS          = YES
AUTOLINK_SUPPORT       = YES
BUILTIN_STL_SUPPORT    = NO
SUBGROUPING            = YES
NUM_PROC_THREADS       = 1
TIMESTAMP              = NO
OUTPUT_LANGUAGE        = English
TAB_SIZE               = 4

#---------------------------------------------------------------------------
# Input
# Each component's header files are included directly.
# Third-party vendored headers (rapidjson, spdlog, paho, fastdds wrappers)
# are excluded to keep the output focused on CPS source code.
#---------------------------------------------------------------------------

INPUT                  = ./README.md \
                         ./generation/generation.h \
                         ./generation/aggregator.h \
                         ./generation/builder.h \
                         ./generation/locator.h \
                         ./generation/metrics.h \
                         ./generation/aggregator.cpp \
                         ./generation/builder.cpp \
                         ./generation/locator.cpp \
                         ./generation/generation.cpp \
                         ./generation/main.cpp \
                         ./processing/processor.h \
                         ./processing/locator.h \
                         ./processing/metrics.h \
                         ./processing/processor.cpp \
                         ./processing/locator.cpp \
                         ./processing/main.cpp \
                         ./sensor-adapters/camera-adapter/camera_adapter.h \
                         ./sensor-adapters/camera-adapter/camera_adapter.cpp \
                         ./sensor-adapters/radar-adapter/radar_adapter.h \
                         ./sensor-adapters/radar-adapter/radar_adapter.cpp \
                         ./sensor-adapters/bike-adapter/bike_adapter.h \
                         ./sensor-adapters/bike-adapter/bike_adapter.cpp \
                         ./sensor-adapters/autoware-adapter/autoware_adapter.h \
                         ./sensor-adapters/autoware-adapter/autoware_adapter.cpp \
                         ./docs \
                         ./LICENSE

USE_MDFILE_AS_MAINPAGE = README.md

INPUT_ENCODING         = UTF-8
RECURSIVE              = NO
FILE_PATTERNS          = *.h \
                         *.cpp \
                         *.md

#---------------------------------------------------------------------------
# Source browsing
#---------------------------------------------------------------------------

SOURCE_BROWSER         = NO
REFERENCED_BY_RELATION = NO
REFERENCES_RELATION    = NO

#---------------------------------------------------------------------------
# HTML output
#---------------------------------------------------------------------------

GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO
GENERATE_MAN           = NO

#---------------------------------------------------------------------------
# Graphs (requires Graphviz / dot)
#---------------------------------------------------------------------------

HAVE_DOT               = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = NO
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
